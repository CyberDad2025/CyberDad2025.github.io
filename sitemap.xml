---
layout: null
# Custom sitemap so jekyll-sitemap does not also emit /page2/ through /page99/.
# Pagination in _config.yml stays on. This file is the template jekyll-sitemap
# skips when /sitemap.xml already exists (jekyll-sitemap 1.4 file_exists?).
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{% if page.xsl %}
  <?xml-stylesheet type="text/xsl" href="{{ "/sitemap.xsl" | absolute_url }}"?>
{% endif %}
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign collections = site.collections | where_exp:'collection','collection.output != false' %}
  {% for collection in collections %}
    {% assign docs = collection.docs | where_exp:'doc','doc.sitemap != false' %}
    {% for doc in docs %}
      <url>
        <loc>{{ doc.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
        {% if doc.last_modified_at or doc.date %}
          <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endfor %}
  {% endfor %}

  {% assign pages = site.html_pages | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.url != "/404.html"' %}
  {% for page in pages %}
    {% assign page_url = page.url | replace:'/index.html','/' %}
    {% assign skip_page = "" %}
    {% for n in (2..99) %}
      {% assign page_n = n | prepend:'/page' | append:'/' %}
      {% assign page_n_index = page_n | append:'index.html' %}
      {% assign page_n_bare = n | prepend:'/page' %}
      {% if page_url == page_n or page_url == page_n_index or page_url == page_n_bare %}
        {% assign skip_page = "yes" %}
      {% endif %}
    {% endfor %}
    {% unless skip_page == "yes" %}
    <url>
      <loc>{{ page_url | absolute_url | xml_escape }}</loc>
      {% if page.last_modified_at %}
        <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
    {% endunless %}
  {% endfor %}

  {% for file in site.static_files %}
    {% assign ext = file.extname %}
    {% if ext == ".html" or ext == ".htm" or ext == ".xhtml" or ext == ".pdf" %}
      {% unless file.name == "404.html" or file.sitemap == false %}
      <url>
        <loc>{{ file.path | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
        <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
      </url>
      {% endunless %}
    {% endif %}
  {% endfor %}
</urlset>
